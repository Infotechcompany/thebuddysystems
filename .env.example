# Copy to .env and review before deployment.
COMPOSE_PROJECT_NAME=thebuddysystems

# Replace this placeholder with an immutable application image tag or digest.
APP_IMAGE=your-app-image:1.0.0
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080
APP_HTTPS_BIND=127.0.0.1
APP_HTTPS_PORT=8443

# Keep the current database image during this repair; upgrade it as a separate,
# backup-tested migration with an explicit rollback plan.
DB_IMAGE=mariadb:10.5
DB_NAME=thebuddysystems
DB_USER=thebuddysystems
