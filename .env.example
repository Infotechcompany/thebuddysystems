COMPOSE_PROJECT_NAME=thebuddysystems

# Required: replace this value with an immutable application image tag or digest.
APP_IMAGE=example.invalid/thebuddysystems/app:replace-me

# Database identity. Passwords are generated into .secrets/ by setup.sh.
DB_NAME=thebuddysystems
DB_USER=thebuddysystems

# Host exposure defaults to loopback so a reverse proxy can terminate public traffic.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Required: choose deliberately. For a fresh deployment, review the current MariaDB LTS.
# Existing databases require a tested backup, restore, and version-by-version migration plan.
MARIADB_IMAGE=example.invalid/mariadb:review-required

# Local Compose resource constraints.
APP_CPUS=0.50
APP_MEMORY_LIMIT=256m
DB_CPUS=1.00
DB_MEMORY_LIMIT=512m
